{
	"name": "themeum/framework",
	"type": "library",
	"description": "Laravel-inspired PHP framework for WordPress plugins",
	"license": "GPL-2.0-or-later",
	"version": "1.0.0",
	"keywords": [
		"wordpress",
		"framework",
		"themeum"
	],
	"authors": [
		{
			"name": "Themeum",
			"email": "support@themeum.com"
		}
	],
	"homepage": "https://github.com/themeum/framework",
	"require": {
		"php": ">=7.0",
		"nesbot/carbon": "^1.39",
		"symfony/translation": "^3.4",
		"symfony/polyfill-mbstring": "~1.19.0"
	},
	"require-dev": {
		"fakerphp/faker": "^1.23",
		"php-stubs/wordpress-stubs": "^6.0",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpunit/phpunit": "^9.0",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Framework\\": "src/"
		},
		"files": [
			"src/helpers.php",
			"src/Polyfill/Polyfill.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Framework\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "7.0.33"
		},
		"audit": {
			"ignore": {
				"PKSA-csyb-yc4p-mnbs": "Carbon 1.x locale file inclusion advisory; locale is never set from user input in this framework."
			}
		},
		"allow-plugins": {
			"kylekatarnls/update-helper": false
		}
	},
	"minimum-stability": "stable",
	"archive": {
		"exclude": [
			".vscode",
			"scripts",
			"stubs",
			"phpstan.neon.dist",
			"README.md",
			".gitignore",
			".gitattributes"
		]
	},
	"scripts": {
		"post-install-cmd": "@link-ide-stubs",
		"post-update-cmd": "@link-ide-stubs",
		"link-ide-stubs": "php scripts/link-ide-stubs.php",
		"test": "vendor/bin/phpunit --testdox",
		"test:unit": "vendor/bin/phpunit --testsuite Unit --testdox"
	}
}
